# Copy to .env.local and fill in. Never commit real values.

# Supabase project URL and publishable key (safe for the browser; RLS protects the data).
# Local values come from `npm run db:status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key. Server and scripts only; never exposed to the browser.
SUPABASE_SECRET_KEY=

# The single e-mail address that may sign in. Everything else is rejected.
ALLOWED_EMAIL=

# Registers the test module "deneme" (src/modules/deneme). For local development, the test
# runs and a dev deployment; leave it unset in production.
NEXT_PUBLIC_SHERPA_DEMO_MODULE=1
